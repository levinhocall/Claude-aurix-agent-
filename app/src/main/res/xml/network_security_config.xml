<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is enabled only so LAN model servers (Ollama etc.) work; CleartextGuard (OkHttp interceptor) rejects http to any non-local host. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
